# GitHub OAuth App credentials (see README.md for how to create these)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Random secret for NextAuth session encryption — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The full URL this app is deployed at (http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# Only this GitHub username is allowed to sign in
ALLOWED_GITHUB_USERNAME=ChamathDilshanC

# Which repo resume.json / the PDF workflow live in
RESUME_REPO_OWNER=ChamathDilshanC
RESUME_REPO_NAME=resume-core
