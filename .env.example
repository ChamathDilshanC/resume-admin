# GitHub OAuth App credentials (see README.md for how to create these)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Random secret for NextAuth session encryption — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The full URL this app is deployed at (http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# Only this GitHub username is allowed to sign in
ALLOWED_GITHUB_USERNAME=ChamathDilshanC

# Which repo the pipeline code / PDF workflow live in
RESUME_REPO_OWNER=ChamathDilshanC
RESUME_REPO_NAME=resume-core

# Which private repo resume.json itself lives in (contact details, reference
# phone numbers — kept out of the public resume-core repo). The signed-in
# GitHub account needs read/write access to this repo.
RESUME_DATA_REPO_NAME=resume-data

# Powers "Import from GitHub" on the Projects tab (fetches a repo's real
# languages, then asks the Gemini API to write bullet points from them).
# Same provider setup as resume-core's AI step.
#
# AI_API_KEY accepts one Google AI Studio key, or several comma-separated
# (e.g. from separate Google accounts) — if one key gets rate-limited (429),
# the next key is tried automatically before giving up.
AI_API_KEY=
# Optional: override the first model tried (falls back through
# gemini-flash-latest -> gemini-2.5-flash -> gemini-2.5-flash-lite regardless).
AI_MODEL=
